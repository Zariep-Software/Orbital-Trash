{
	"description": "Rocket that push garbage out of the atmosphere",
	"dependencies": {
		"raylib-d": "~>6.0.1"
	},
	"authors": [
		"ItsZariep"
	],
	"copyright": "Copyright © 2026, ItsZariep",
	"license": "GPL-3.0-only",
	"name": "orbital-trash",

	"stringImportPaths": ["source"],
	"configurations": [
		{
			"name": "default",
			"targetType": "executable",
			"targetName": "orbital-trash-gnu.x86_64",
			"libs": ["raylib"],
			"lflags-posix": ["-L."],
			"libs-linux": ["raylib", "GL", "m", "pthread", "dl", "rt", "X11"]
		},
		{
			"name": "windows",
			"targetType": "executable",
			"targetName": "orbital-trash",
			"dflags": ["-linker=lld-link", "-mscrtlib=libcmt"],
			"lflags": [
				"/LIBPATH:.",
				"/LIBPATH:$HOME/.local/include/windows-msvc-sysroot/lib/x86_64-unknown-windows-msvc",
				"/LIBPATH:$HOME/.local/include/ldc2/w64/lib",
				"/LIBPATH:$HOME/.local/include/winlibs-upper"
			],
			"libs": ["raylib", "winmm", "gdi32", "user32", "shell32", "kernel32", "opengl32"]
		},
		{
			"name": "android",
			"targetType": "dynamicLibrary",
			"targetName": "main",
			"dependencies": {
				"raylib-d": "~>6.0.1"
			},
			"subConfigurations": {
				"raylib-d": "library"
			},
			"libs-posix": []
		}
	]
}